# Copy to .env and fill in. All variables are optional except SECRET_KEY in production.
LINGO_SECRET_KEY=replace-with-a-long-random-string
LINGO_DATABASE_URL=sqlite+aiosqlite:///./lingoflix.db

# LLM (pick one; Anthropic preferred). Without a key the heuristic engine runs.
LINGO_ANTHROPIC_API_KEY=
LINGO_ANTHROPIC_MODEL=claude-opus-5
LINGO_GEMINI_API_KEY=

# Optional: OpenSubtitles REST API key for subtitle search/download
LINGO_OPENSUBTITLES_API_KEY=

# Optional: Netscape cookies file for yt-dlp if YouTube asks for sign-in
LINGO_YTDLP_COOKIES_FILE=

# App auto-update: bump these whenever you publish a new APK build
LINGO_APP_LATEST_VERSION_CODE=10
LINGO_APP_LATEST_VERSION_NAME=2.0
LINGO_APP_DOWNLOAD_URL=https://github.com/<owner>/<repo>/releases/download/v2.0/app-release.apk
LINGO_APP_UPDATE_NOTES=
LINGO_APP_FORCE_UPDATE=false
